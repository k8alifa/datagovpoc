{
  "source": "KHDA Timeliness and Field Metadata Workbook v0.1 (Timeliness matrix), from Data Dictionary Service Mapping V3. 69 distinct services in 75 service rows across 10 categories. Data types and starting values are a DS&A proposal [confirm].",
  "dataTypes": [
    {
      "code": "T1",
      "name": "Institution licensing and changes",
      "covers": "A case that creates or changes an institution record: permits issued, renewed or cancelled; changes of name, premises, owners, manager or principal; grades, programs, courses, fees, age groups.",
      "trigger": "KHDA approves the case.",
      "dateField": "Case decision date (WorkflowCase CASELAST_PROCESSDATE) or permit ISSUED_ON",
      "defaultRule": "The institution record shows the approved change on the day the case is approved.",
      "howMeasured": "Lag from case approval to record update. Share of active institutions whose permit EXPIRY_ON has passed with no renewal or status change.",
      "proposedStartingValue": "1 working day",
      "confirm": true
    },
    {
      "code": "T2",
      "name": "Person and enrollment records",
      "covers": "Records of students, staff and parent contracts that institutions report: registrations, amendments, deletions, promotions, staff assignments, contracts.",
      "trigger": "The real-world event: a student joins, leaves, transfers or is promoted; a staff member joins or leaves; a contract is signed.",
      "dateField": "Event date in the record (for example EnrollmentCommencedDate, WithdrawalDate, CurrPosition_DOJ, LeavingDate, SignDate)",
      "defaultRule": "The institution records the event within the committed number of working days after it happens.",
      "howMeasured": "Lag from event date to record date. Share of events recorded within the commitment. Not measurable where the view has no event date (see Gaps sheet).",
      "proposedStartingValue": "10 working days",
      "confirm": true
    },
    {
      "code": "T3",
      "name": "Periodic institution returns",
      "covers": "Data every institution submits on a fixed cycle: exam datasets, people of determination returns, school profile returns, annual activity programs.",
      "trigger": "The cycle deadline (for example the census date or the start of the academic year).",
      "dateField": "Cycle deadline set in the commitment; record CreatedOn or UpdatedOn",
      "defaultRule": "Every in-scope institution submits a complete return by the committed date.",
      "howMeasured": "Share of institutions with a complete return by the committed date. Days late for the rest.",
      "proposedStartingValue": "Deadline set per cycle",
      "confirm": true
    },
    {
      "code": "T4",
      "name": "Field visits",
      "covers": "Data captured by KHDA staff during inspection and compliance visits.",
      "trigger": "The visit ends.",
      "dateField": "Visit date (InspectionOn, InspectionDate, Schedule_InspectionTo) and report date (ReportDate)",
      "defaultRule": "Visit findings are recorded within the committed days after the visit, and the report within the committed days after that.",
      "howMeasured": "Lag from visit date to record and to report date.",
      "proposedStartingValue": "5 working days",
      "confirm": true
    },
    {
      "code": "T5",
      "name": "Certificates and approvals on request",
      "covers": "Cases that issue a document or a one-off approval and change little master data: attestations, certificates, letters, advertising approvals.",
      "trigger": "KHDA decides the case.",
      "dateField": "Case decision date (WorkflowCase CASELAST_PROCESSDATE)",
      "defaultRule": "The decision and its date are recorded on the day the decision is made. Processing time is a service level that Service Design documents and monitors; it is measured separately.",
      "howMeasured": "Share of closed cases with a decision date and outcome recorded on the decision day.",
      "proposedStartingValue": "Same day",
      "confirm": true
    },
    {
      "code": "T6",
      "name": "Manual collections",
      "covers": "Data kept outside a KHDA system: spreadsheets, emailed files, paper, survey exports with no system of record.",
      "trigger": "Not applicable.",
      "dateField": "None",
      "defaultRule": "Not measurable. The collection must be registered and moved into a system under the KHDA Data Collection and Source Capture Policy (KHDA-DP-07).",
      "howMeasured": "Count of registered manual collections, and the share with an approved digitization request.",
      "proposedStartingValue": "Not applicable",
      "confirm": true
    },
    {
      "code": "T6",
      "name": "Manual collections",
      "covers": "Data kept outside any system of record",
      "trigger": "Not applicable",
      "dateField": "None",
      "defaultRule": "Not measurable. The collection must be digitized under KHDA-DP-07",
      "howMeasured": "Not measurable",
      "proposedStartingValue": "Not applicable",
      "confirm": true
    }
  ],
